{
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/(.*\\.js)$", "dest": "/$1" },
    { "src": "^/(.*\\.css)$", "dest": "/$1" },
    { "src": "^/(.*\\.png)$", "dest": "/$1" },
    { "src": "^/(.*\\.jpg)$", "dest": "/$1" },
    { "src": "^/(.*\\.svg)$", "dest": "/$1" },
    { "src": "^/(.*\\.ico)$", "dest": "/$1" },
    { "src": "^/(.*\\.woff2?)$", "dest": "/$1" },
    { "src": "^/insights/?$", "dest": "/insights/index.html" },
    { "src": "^/insights/([a-z0-9]+(?:-[a-z0-9]+)*)/?$", "dest": "/insights/$1/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "outputDirectory": "dist"
}
